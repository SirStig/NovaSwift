; Godot 4 project — NOVA Swift desktop (Linux/Windows/macOS) frontend.
; This hosts the vertical slice that drives the Swift engine through the
; NovaSwiftGodot GDExtension. See docs/GODOT_LAYER.md.
;
; Engine floor: Godot 4.6. It is not a taste call — it tracks whatever Godot
; release SwiftGodot's pinned `main` revision generates its bindings against
; (godot/bridge/Package.swift), because a GDExtension built against a newer
; extension_api.json than the host engine provides is a crash, not a
; degradation. Bump this and NovaSwift.gdextension's compatibility_minimum
; together whenever that pin moves. Developed and run against Godot 4.7.

config_version=5

[application]

config/name="NOVA Swift (Godot)"
config/description="Cross-platform desktop frontend for NOVA Swift, driving the Swift engine via a SwiftGodot GDExtension."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.png"
config/version="0.7.0"

[autoload]

; Logical viewport = window size in points (no magnify-to-fill). See WindowScale.gd.
WindowScale="*res://WindowScale.gd"
; Live user-settings plumbing (engine, Caps Lock 2x, mouse aim, colorblind, FPS, UI scale...): SettingsPlumbing.gd.
SettingsPlumbing="*res://SettingsPlumbing.gd"
; Gamepad on-screen keyboard that opens for any LineEdit focused with a pad: ui/PadKeyboard.gd.
PadKeyboard="*res://ui/PadKeyboard.gd"
; Gamepad UI cursor (left stick pointer, A click, right stick scroll; synthesises mouse events): ui/PadCursor.gd.
PadCursor="*res://ui/PadCursor.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
; Expand: a 16:10 screen (Steam Deck, 1280x800) gets the extra height instead of
; letterbox bars. The HUD and every screen lay themselves out off the viewport
; rect / anchors, so they follow the larger area.
window/stretch/aspect="expand"

[rendering]

; Required so the macOS (arm64) export is allowed; harmless elsewhere (extra ASTC imports).
textures/vram_compression/import_etc2_astc=true

; Black, not Godot's default grey: any frame where no screen has drawn yet
; (e.g. main menu -> flight hand-off) shows black like the original.
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

; Compatibility (OpenGL) renderer for the widest Linux/Windows GPU coverage.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
