# Godot editor cache / imported assets — regenerated on open.
.godot/

# Built native GDExtension libraries — produced by scripts/build-gdextension.sh,
# not committed (platform-specific, large). bin/ itself is kept via .gitkeep.
bin/*.so
bin/*.dll
bin/*.dylib
bin/*.dSYM/
bin/*.pdb
bin/*.lib
bin/*.exp

# Godot export output.
export/
*.import

# Export signing credentials/keystores written by the Godot editor — never commit.
export_credentials.cfg
*.keystore
# Godot export-template archives (downloaded by the packaging scripts).
*.tpz

# NOTE: *.gd.uid / *.uid files ARE committed (Godot 4.4+ resource UIDs; keep them with their scripts).

# Local play-testing harness (interactive bot driver) — not part of the game or its test suite.
tests/playbot.gd
tests/playbot.gd.uid

# Bundled decode-only ffmpeg (scripts/build-mini-ffmpeg.sh).
bin/ffmpeg/
