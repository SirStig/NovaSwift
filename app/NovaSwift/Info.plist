<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>GCSupportedGameControllers</key>
	<array>
		<dict>
			<key>ProfileName</key>
			<string>ExtendedGamepad</string>
		</dict>
	</array>
	<key>NSBonjourServices</key>
	<array>
		<string>_novaswift-mp._tcp</string>
		<string>_novaswift-mp._udp</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Expose the app's Documents folder in the Files app and over Finder file
	     sharing. That's where `BugReport` writes its Diagnostics/*.zip bundles,
	     so a tester who can't get the share sheet where they want it can still
	     hand the file over. Note this exposes Documents only — pilot saves live
	     in Application Support (see `NovaStorage.root`) and stay private; the
	     save reaches a report by being copied into the bundle, not by being
	     browsable. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
